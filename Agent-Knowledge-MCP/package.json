{
  "name": "agent-knowledge-mcp",
  "version": "0.3.0",
  "description": "Servidor MCP (stdio, somente leitura) que expõe a Knowledge Base de Agent Engineering do Obsidian a outros agentes, com o contrato do Universal Agent Runtime.",
  "type": "module",
  "private": true,
  "license": "UNLICENSED",
  "bin": {
    "agent-knowledge-mcp": "dist/src/index.js"
  },
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "test": "npm run build && node --test --test-reporter=spec dist/tests/*.test.js",
    "test:real": "npm run build && sh scripts/test-real-vaults.sh",
    "smoke": "npm run build && node scripts/smoke-client.mjs",
    "simulate": "npm run build && node scripts/simulate-orchestration.mjs",
    "detect-env": "npm run build && node scripts/detect-env.mjs",
    "experiment": "npm run build && node scripts/delegation-experiment.mjs",
    "validate:harness": "node scripts/validate-harness.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "yaml": "2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.9.3"
  }
}
