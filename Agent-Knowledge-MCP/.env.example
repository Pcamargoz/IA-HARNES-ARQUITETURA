# Agent-Knowledge-MCP — exemplo de configuração (copie para .env só se usar um loader; o servidor lê variáveis de ambiente do cliente MCP).
# Nunca coloque credenciais aqui: o servidor não precisa de nenhuma.

# Raízes autorizadas: nome=caminho separados por ';' (somente leitura)
AKM_VAULT_ROOTS="cofre=/CAMINHO/PARA/Cofre do Pedro;harness=/CAMINHO/PARA/Harness-Architecture"

# Subpastas indexadas por raiz (JSON). Raiz ausente = raiz inteira.
AKM_ROOT_INCLUDE='{"cofre":["AI-Agent-Ecosystem","Skills para main agents"]}'

# Raiz e subpasta da Knowledge Base
AKM_KB_ROOT=cofre
AKM_KB_SUBDIR=AI-Agent-Ecosystem
# Raiz do Harness de referência
AKM_HARNESS_ROOT=harness

# Limites (economia de tokens)
AKM_DEFAULT_RESULTS=5
AKM_MAX_RESULTS=20
AKM_SNIPPET_CHARS=220
AKM_MAX_DOC_CHARS=6000
AKM_MAX_FILE_BYTES=1000000
AKM_INDEX_TTL_MS=2000

# Padrões extras de bloqueio (regex, separados por ';'), aplicados ao caminho relativo
# AKM_DENY_PATTERNS="Projetos/TRADERS FAKALUM/;rascunho"

# Log em stderr: error | warn | info | debug
AKM_LOG_LEVEL=info
# AKM_RUNTIME_MANIFEST=/caminho/para/environment-manifest.json   # padrão: runtime-output/environment-manifest.json
