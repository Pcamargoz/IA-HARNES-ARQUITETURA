# Vault root. If empty, uses the parent directory of .mcp
VAULT_ROOT=

# Writes: 0 = read-only (default). 1 = allow writes to the folders below.
VAULT_ALLOW_WRITES=0

# Writable folders when writes are enabled (comma-separated)
VAULT_WRITE_ROOTS=Inbox

# Commit via MCP: 0 = disabled (default). 1 = enables vault_commit.
VAULT_ALLOW_GIT=0

# Read limit in characters per call
VAULT_MAX_READ_CHARS=20000

# Index trust window in ms before re-checking the disk for changes (0 = every call)
VAULT_INDEX_TTL_MS=3000

# Days without an `updated` bump before vault_health flags a note as stale
VAULT_STALE_DAYS=90
